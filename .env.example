# Standalone server and optional AI settings. Empty AI credentials keep local policies active.
PORT=3000
HOST=0.0.0.0
DATABASE_URL=file:./data/world.db
JWT_SECRET=
# At least 32 characters to enable one-time admin bootstrap.
ADMIN_SECRET=
SESSION_COOKIE_SECURE=false
GEMINI_API_KEY=
GEMINI_MODEL=
DAY_DURATION_HOURS=6
SIMULATION_TICK_MS=1000
# Optional compatible provider; these names do not reuse sandbox OPENAI_API_KEY.
OPENAI_COMPATIBLE_BASE_URL=
AI_PROVIDER_KEY=
AI_PROVIDER_MODEL=
# Optional provider array imported only on first runtime-settings initialization.
AI_PROVIDERS_JSON=[]
# Optional base64 32-byte master key; otherwise a private key file is created beside SQLite.
AI_ENCRYPTION_KEY=
AI_REQUEST_BUDGET_PER_MINUTE=20
AI_TOKEN_BUDGET_PER_MINUTE=30000
AI_TIMEOUT_MS=5000
# Explicit additional trusted origins for local/private services, comma-separated.
# Default Ollama localhost:11434 is permitted without an override.
AI_ALLOWED_ORIGINS=
# Positive integer Influence Point costs. Strong influence is still not guaranteed.
INTERVENTION_SUBTLE_COST=2
INTERVENTION_MEDIUM_COST=5
INTERVENTION_STRONG_COST=9
